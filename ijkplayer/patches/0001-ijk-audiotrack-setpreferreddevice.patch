+    @CalledByNative
+    private static void applyPreferredAudioDevice(AudioTrack track) {
+        try {
+            if (track != null && Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+                // A null device resets the track to default system routing.
+                track.setPreferredDevice(sPreferredAudioDevice);
+            }
+        } catch (Throwable t) {
+            DebugLog.printStackTrace(t);
+        }
+    }
