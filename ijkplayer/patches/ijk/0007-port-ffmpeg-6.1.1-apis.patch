+static int ijk_packet_set_position_opaque(AVPacket *packet)
+{
+    AVBufferRef *position_ref;
+
+    if (packet->pos < 0)
+        return 0;
+
+    position_ref = av_buffer_alloc(sizeof(packet->pos));
+    if (!position_ref)
+        return AVERROR(ENOMEM);
+
+    memcpy(position_ref->data, &packet->pos, sizeof(packet->pos));
+    av_buffer_unref(&packet->opaque_ref);
+    packet->opaque_ref = position_ref;
+    return 0;
+}
+
+static int64_t ijk_frame_get_packet_position(const AVFrame *frame)
+{
+    int64_t position = -1;
+
+    if (frame->opaque_ref && frame->opaque_ref->size == sizeof(position))
+        memcpy(&position, frame->opaque_ref->data, sizeof(position));
+
+    return position;
+}
+
+static int ijk_av_dict_set_pointer(AVDictionary **dict, const char *key, const void *value)
+{
+    char buffer[2 + sizeof(uintptr_t) * 2 + 1];
+    snprintf(buffer, sizeof(buffer), "%p", value);
+    return av_dict_set(dict, key, buffer, 0);
+}
