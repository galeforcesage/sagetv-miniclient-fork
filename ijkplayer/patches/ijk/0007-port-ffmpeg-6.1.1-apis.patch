+# libavcodec and libswscale compile the same FFmpeg half-float table source.
+# Keep one definition when relinking all static objects into libijkffmpeg.so.
+FF_C_OBJ_FILES=$(printf '%s\n' $FF_C_OBJ_FILES | grep -v '^libswscale/half2float.o$' | tr '\n' ' ')
+
 set -x
 $CC -lm -lz -shared --sysroot=$FF_SYSROOT -Wl,--no-undefined -Wl,-z,noexecstack $FF_EXTRA_LDFLAGS \
     -Wl,-soname,libijkffmpeg.so \
     $FF_C_OBJ_FILES \
-    $FF_ASM_OBJ_FILES \
-    $FF_DEP_LIBS \
+    $FF_DEP_LIBS -landroid -lmediandk \
     -o $FF_PREFIX/libijkffmpeg.so
 { set +x; } 2>/dev/null
 
