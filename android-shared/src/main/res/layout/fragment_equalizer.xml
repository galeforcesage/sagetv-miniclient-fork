<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6000000"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Equalizer"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/eq_enabled_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EQ On"
            android:textColor="#FFFFFF"
            android:buttonTint="#4FC3F7" />

        <CheckBox
            android:id="@+id/eq_client_processing_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Process on this device"
            android:textColor="#FFFFFF"
            android:buttonTint="#4FC3F7" />
    </LinearLayout>

    <!-- Preset spinner + Reset -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preset: "
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/eq_preset_spinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#4FC3F7" />

        <Button
            android:id="@+id/eq_reset_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Reset"
            android:textColor="#FFFFFF"
            style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>

    <!-- Preamp slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preamp"
            android:textColor="#4FC3F7"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/eq_preamp_seekbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:max="48"
            android:progress="24"
            android:progressTint="#4FC3F7"
            android:thumbTint="#4FC3F7" />

        <TextView
            android:id="@+id/eq_preamp_value"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="0 dB"
            android:textColor="#CCCCCC"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Band sliders container (populated dynamically) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/eq_bands_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="bottom|center_horizontal"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- EQ Off indicator -->
    <TextView
        android:id="@+id/eq_off_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="4dp"
        android:text="EQ OFF"
        android:textColor="#FF5252"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Night Mode section -->
    <LinearLayout
        android:id="@+id/eq_night_mode_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:visibility="gone">

        <CheckBox
            android:id="@+id/eq_night_mode_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Night Mode"
            android:textColor="#FFFFFF"
            android:buttonTint="#4FC3F7" />

        <Spinner
            android:id="@+id/eq_night_intensity_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:backgroundTint="#4FC3F7" />
    </LinearLayout>

    <!-- Connection status (mirrors the PWA client's live-EQ indicator) -->
    <TextView
        android:id="@+id/eq_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text=""
        android:textColor="#AAAAAA"
        android:textSize="13sp" />

    <!-- Recommendation: shown when the device can fully handle the current EQ -->
    <TextView
        android:id="@+id/eq_recommend_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text=""
        android:textColor="#FFB74D"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Close button -->
    <Button
        android:id="@+id/eq_close_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:text="Close"
        android:textColor="#4FC3F7"
        style="?android:attr/borderlessButtonStyle" />

</LinearLayout>
