<?xml version="1.0" encoding="utf-8"?>
<!-- Single EQ band: vertical SeekBar + frequency label + gain value -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="48dp"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <!-- dB value at top -->
    <TextView
        android:id="@+id/eq_band_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="#CCCCCC"
        android:textSize="10sp"
        android:gravity="center" />

    <!-- Vertical SeekBar (rotated 270°) -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="0dp"
        android:layout_weight="1">

        <SeekBar
            android:id="@+id/eq_band_seekbar"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:rotation="270"
            android:max="48"
            android:progress="24"
            android:progressTint="#4FC3F7"
            android:thumbTint="#4FC3F7" />
    </FrameLayout>

    <!-- Frequency label at bottom -->
    <TextView
        android:id="@+id/eq_band_freq"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1K"
        android:textColor="#AAAAAA"
        android:textSize="10sp"
        android:gravity="center" />

</LinearLayout>
