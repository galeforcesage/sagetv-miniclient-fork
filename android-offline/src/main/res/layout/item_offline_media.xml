<?xml version="1.0" encoding="utf-8"?>
<!-- Compact SageTV-style row item used in the recordings list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/offline_recording_row_bg"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_marginBottom="2dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:descendantFocusability="afterDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/offline_item_thumbnail"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@android:drawable/ic_menu_agenda"
            android:tint="@color/offline_text_secondary"
            android:contentDescription="Recording" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/offline_item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFE6E6E6"
                android:textSize="18sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/offline_item_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FFFFFFFF"
                android:textSize="19sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/offline_item_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/offline_item_status_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/offline_library_status_badge_bg"
            android:padding="2dp"
            android:contentDescription="Status" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/offline_item_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:visibility="gone"
        android:progressTint="#FF4ED04E"
        android:progressBackgroundTint="#405A5A5A"
        android:progressDrawable="@android:drawable/progress_horizontal" />

</LinearLayout>
