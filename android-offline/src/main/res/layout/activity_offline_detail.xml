<?xml version="1.0" encoding="utf-8"?>
<!-- M4: SageTV-style offline detail screen.
     Fanart background image fills the screen; a dark scrim overlays it; on
     top sits a scrollable detail panel (poster + metadata + cast row).
     Gracefully degrades when fanart/poster/metadata are absent. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/offline_bg_primary"
    android:fitsSystemWindows="true">

    <!-- Fanart background -->
    <ImageView
        android:id="@+id/detail_fanart"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Fanart"
        android:alpha="0.45" />

    <!-- Dark scrim for legibility -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000" />

    <!-- Top header bar with back arrow -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/offline_bg_secondary"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/detail_back_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:src="@drawable/ic_arrow_back_white_24dp"
            android:contentDescription="Back"
            android:tint="@color/offline_text_accent"
            android:background="@drawable/iconbutton_background" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/detail_back_button"
            android:layout_marginStart="16dp"
            android:text="Recording Details"
            android:textColor="@color/offline_text_primary"
            android:textSize="26sp"
            android:fontFamily="sans-serif-light" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_marginTop="72dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp">

            <!-- Top section: poster + key facts -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/detail_poster"
                    android:layout_width="220dp"
                    android:layout_height="330dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="Poster"
                    android:background="@color/offline_bg_card" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="32dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/detail_show_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/offline_text_accent"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/detail_episode_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/offline_text_primary"
                        android:textSize="32sp"
                        android:fontFamily="sans-serif-light" />

                    <TextView
                        android:id="@+id/detail_subline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/offline_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/detail_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textColor="@color/offline_text_primary"
                        android:textSize="15sp"
                        android:lineSpacingMultiplier="1.2" />

                    <TextView
                        android:id="@+id/detail_categories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/offline_text_secondary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/detail_play_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Play"
                        android:textColor="@color/offline_text_primary"
                        android:background="@color/offline_progress_fill"
                        android:paddingStart="32dp"
                        android:paddingEnd="32dp" />

                </LinearLayout>
            </LinearLayout>

            <!-- Aired On metadata section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Aired On:"
                android:textColor="@color/offline_text_accent"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/detail_aired_on"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/offline_text_primary"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.5" />

            <!-- ShowID and other metadata -->
            <TextView
                android:id="@+id/detail_metadata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/offline_text_secondary"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.4" />

            <!-- Host / People -->
            <TextView
                android:id="@+id/detail_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/offline_text_secondary"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.4" />

            <!-- Starring row (Cast) -->
            <TextView
                android:id="@+id/detail_cast_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Starring:"
                android:textColor="@color/offline_text_accent"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/detail_cast_list"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:paddingEnd="32dp"
                android:visibility="gone" />

            <!-- Crew block -->
            <TextView
                android:id="@+id/detail_crew"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textColor="@color/offline_text_secondary"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.4" />

            <!-- Technical / file block -->
            <TextView
                android:id="@+id/detail_files_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Files"
                android:textColor="@color/offline_text_accent"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/detail_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/offline_text_secondary"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.4" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
