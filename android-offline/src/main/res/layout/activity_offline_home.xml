<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/secure_login_bg">

    <LinearLayout
        android:id="@+id/offline_left_rail"
        android:layout_width="232dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="34dp"
        android:paddingBottom="18dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="#A6000000">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/offline_nav_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TV"
                android:textColor="#F2F2F2"
                android:textSize="50sp"
                android:fontFamily="sans-serif-light"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:background="@drawable/offline_menu_item_bg" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="2dp"
                android:src="@drawable/ic_play_arrow_white_24dp"
                android:alpha="0.75" />
        </LinearLayout>

        <TextView
            android:id="@+id/offline_home_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#99FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/offline_nav_videos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Videos"
            android:textColor="#CCCCCC"
            android:textSize="42sp"
            android:fontFamily="sans-serif-light"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/offline_menu_item_bg" />

        <TextView
            android:id="@+id/offline_nav_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Search"
            android:textColor="#CCCCCC"
            android:textSize="42sp"
            android:fontFamily="sans-serif-light"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/offline_menu_item_bg" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/offline_nav_exit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Exit"
            android:textColor="#F2F2F2"
            android:textSize="56sp"
            android:fontFamily="sans-serif-light"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/offline_menu_item_bg" />

    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_toEndOf="@id/offline_left_rail"
        android:background="#66FFFFFF" />

    <LinearLayout
        android:id="@+id/offline_tv_panel"
        android:layout_width="388dp"
        android:layout_height="match_parent"
        android:layout_toEndOf="@id/offline_left_rail"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="40dp"
        android:paddingEnd="20dp"
        android:background="#7A111A25"
        android:visibility="gone">

        <TextView
            android:id="@+id/offline_tv_panel_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recordings"
            android:textColor="#E9E9E9"
            android:textSize="50sp"
            android:fontFamily="sans-serif-light" />

        <TextView
            android:id="@+id/offline_tv_recordings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Recordings"
            android:textColor="#E1E1E1"
            android:textSize="36sp"
            android:fontFamily="sans-serif-light"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/offline_menu_item_bg" />

        <TextView
            android:id="@+id/offline_tv_program_guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Program Guide"
            android:textColor="#D0D0D0"
            android:textSize="36sp"
            android:fontFamily="sans-serif-light"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/offline_menu_item_bg" />

        <TextView
            android:id="@+id/offline_tv_recording_schedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Recording Schedule"
            android:textColor="#D0D0D0"
            android:textSize="36sp"
            android:fontFamily="sans-serif-light"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/offline_menu_item_bg" />

    </LinearLayout>

</RelativeLayout>
