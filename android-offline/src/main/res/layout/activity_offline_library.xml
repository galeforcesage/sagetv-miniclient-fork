<?xml version="1.0" encoding="utf-8"?>
<!-- Main offline library layout — matches SageTV7 dark theme layout pattern.
     Header bar with title, then a scrollable list of media cards. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/offline_library_canvas"
    android:fitsSystemWindows="true">

    <!-- Header bar — mimics SageTV menu title area -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/offline_library_top_bar_bg"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/offline_header_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:src="@drawable/ic_arrow_back_white_24dp"
            android:contentDescription="Back"
            android:tint="#CFCFCF"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/offline_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/offline_header_icon"
            android:layout_marginStart="12dp"
            android:text="All Recordings"
            android:textColor="#DADADA"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="1.5"
            android:textSize="31sp"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/offline_header_info"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/offline_header_clock"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:text="i"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:background="@drawable/offline_library_info_dot_bg" />

        <TextView
            android:id="@+id/offline_header_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/offline_divider" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/offline_empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_file_download"
            android:tint="@color/offline_text_secondary"
            android:contentDescription="No downloads" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="No downloaded videos"
            android:textColor="@color/offline_text_secondary"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Connect to your SageTV server to download media"
            android:textColor="@color/offline_text_secondary"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/offline_library_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.6"
            android:orientation="vertical"
            android:background="@drawable/offline_library_left_panel_bg"
            android:padding="8dp">

            <!-- Media list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/offline_media_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:clipToPadding="false" />

        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@color/offline_divider" />

        <LinearLayout
            android:id="@+id/offline_preview_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:orientation="vertical"
            android:background="@drawable/offline_library_right_panel_bg"
            android:padding="12dp">

            <ImageView
                android:id="@+id/offline_preview_thumb"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:background="#1FFFFFFF"
                android:contentDescription="Selected recording thumbnail" />

            <TextView
                android:id="@+id/offline_preview_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/offline_text_primary"
                android:textSize="22sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/offline_preview_episode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/offline_text_accent"
                android:textSize="16sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:visibility="gone" />

            <TextView
                android:id="@+id/offline_preview_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#FFA8C0FF"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/offline_preview_aired_on"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FFA8C0FF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/offline_preview_original_air_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FFA8C0FF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/offline_preview_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FFA8C0FF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/offline_preview_channel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FFA8C0FF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/offline_preview_description"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="10dp"
                android:textColor="#FFE6E6E6"
                android:textSize="16sp"
                android:lineSpacingExtra="3dp"
                android:maxLines="12"
                android:ellipsize="end" />

        </LinearLayout>

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/offline_library_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/offline_library_bottom_bar_bg"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/offline_footer_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:text="0 Items"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Options"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="SageTV"
                android:textColor="#FF6ACB3D"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="2"
                android:textSize="18sp" />
        </LinearLayout>

    </RelativeLayout>

</LinearLayout>
