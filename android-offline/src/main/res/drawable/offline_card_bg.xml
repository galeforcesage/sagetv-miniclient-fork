<?xml version="1.0" encoding="utf-8"?>
<!-- SageTV-style card background with focus state for offline menu items -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/offline_bg_card_focused" />
            <stroke android:width="2dp" android:color="@color/offline_focus_border" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/offline_bg_card_focused" />
            <stroke android:width="2dp" android:color="@color/offline_focus_border" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/offline_bg_card" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>
