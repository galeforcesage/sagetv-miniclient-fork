<?xml version="1.0" encoding="utf-8"?>
<!--
  Android manifest for the offline/download module. Permissions and components
  here are merged into any app module that depends on android-offline. The
  "online-only" APK flavor does NOT depend on this module, so none of these
  permissions or components are present in that APK.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions required only for the download/offline feature set -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <service
            android:name=".DownloadForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name=".DownloadsActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneTheme" />

        <activity
            android:name=".OfflineLibraryActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.PhoneTheme" />

        <activity
            android:name=".OfflinePlaybackActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.PhoneTheme" />
    </application>

</manifest>
